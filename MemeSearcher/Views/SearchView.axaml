<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MemeSearcher.ViewModels"
             xmlns:models="using:MemeSearcher.Core.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="MemeSearcher.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             x:Name="Root">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding QueryText}"
                     PlaceholderText="among us" />
            <Button Grid.Column="1" Content="Find" Command="{Binding SearchCommand}" IsDefault="True" />
        </Grid>

        <CheckBox Grid.Row="1" Margin="0,6,0,0"
                  Content="Composite (assemble from multiple clips)"
                  IsChecked="{Binding IsCompositeMode}" />

        <ItemsControl Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding RecentSearches}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:SearchHistoryEntry">
                    <Button Classes="FilterPill"
                            Content="{Binding QueryText}"
                            ToolTip.Tip="{Binding ScopeDescription}"
                            Command="{Binding #Root.((vm:SearchViewModel)DataContext).RerunSearchCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3" Classes="HeaderLabel" Margin="0,8,0,0" Text="{Binding QueryIpa, StringFormat='IPA: {0}'}" />

        <TextBlock Grid.Row="4" Classes="FieldLabel" Margin="0,4,0,12" Text="{Binding StatusMessage}" />

        <ListBox Grid.Row="5" ItemsSource="{Binding Results}" IsVisible="{Binding !IsCompositeMode}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultRowViewModel">
                    <Border Padding="8" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderMid}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding ScoreDisplay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Classes="HeaderLabel" Text="{Binding TimeRangeDisplay}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SourceText}" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding Ipa}" FontFamily="monospace" Foreground="{StaticResource TextSecondary}" />

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Button Content="▶ Play" Command="{Binding PlayCommand}" />
                                <Button Content="Export clip..." Command="{Binding ExportClipCommand}" />
                                <Button Content="Copy timestamp" Command="{Binding CopyTimestampCommand}" />
                                <Button Content="Copy text" Command="{Binding CopyTextCommand}" />
                                <Button Content="Copy IPA" Command="{Binding CopyIpaCommand}" />
                                <Button Content="Copy phonemes" Command="{Binding CopyPhonemesCommand}" />
                            </StackPanel>
                            <TextBlock Classes="FieldLabel" Text="{Binding PlaybackStatus}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Grid.Row="5" ItemsSource="{Binding CompositeResults}" IsVisible="{Binding IsCompositeMode}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CompositeSearchResultRowViewModel">
                    <Border Padding="8" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderMid}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding ScoreDisplay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Classes="HeaderLabel" Text="{Binding SourceCountDisplay}" />
                                <Button Content="Export assembled clip..." Command="{Binding ExportClipCommand}" />
                            </StackPanel>
                            <TextBlock Classes="FieldLabel" Text="{Binding ExportStatus}" />

                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompositeComponentRowViewModel">
                                        <Border Padding="6" Margin="12,2,0,2" BorderThickness="1" BorderBrush="{StaticResource BorderSubtle}" CornerRadius="3">
                                            <StackPanel Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding MediaTitle}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Classes="HeaderLabel" Text="{Binding TimeRangeDisplay}" />
                                                    <TextBlock Classes="HeaderLabel" Text="{Binding ScoreDisplay}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SourceText}" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Classes="FieldLabel" Text="{Binding Ipa}" FontFamily="monospace" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
