<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MemeSearcher.ViewModels"
             xmlns:models="using:MemeSearcher.Core.Models"
             xmlns:views="using:MemeSearcher.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="MemeSearcher.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <!-- #25: shared between the flat results list and the grouped-by-covered-span view below,
             so grouping doesn't mean maintaining two copies of the same row markup. -->
        <DataTemplate x:Key="ResultRowTemplate" x:DataType="vm:SearchResultRowViewModel">
            <Border Padding="8" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderMid}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding ScoreDisplay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Classes="HeaderLabel" Text="{Binding TimeRangeDisplay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SourceText}" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="{Binding Ipa}" FontFamily="monospace" Foreground="{StaticResource TextSecondary}" />

                    <!-- #25: which part of the query this hit covers, and how - the "moeten" case
                         (five short hits looking like unrelated words) reads correctly once each
                         row shows the slice of the query it accounts for instead of just an opaque
                         score. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <views:PhoneCoverageStripView DataContext="{Binding CoverageStrip}" CellWidth="14" CellHeight="14" CellFontSize="8" />
                        <TextBlock Classes="FieldLabel" Text="{Binding CoverageDisplay}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Button Content="▶ Play" Command="{Binding PlayCommand}" />
                        <Button Content="Export clip..." Command="{Binding ExportClipCommand}" />
                        <Button Content="Copy timestamp" Command="{Binding CopyTimestampCommand}" />
                        <Button Content="Copy text" Command="{Binding CopyTextCommand}" />
                        <Button Content="Copy IPA" Command="{Binding CopyIpaCommand}" />
                        <Button Content="Copy phonemes" Command="{Binding CopyPhonemesCommand}" />
                    </StackPanel>
                    <TextBlock Classes="FieldLabel" Text="{Binding PlaybackStatus}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding QueryText}"
                     PlaceholderText="among us" />
            <Button Grid.Column="1" Content="Find" Command="{Binding SearchCommand}" IsDefault="True" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
            <CheckBox Grid.Column="0"
                      Content="Composite (assemble from multiple clips)"
                      IsChecked="{Binding IsCompositeMode}" />

            <!-- Addendum §13: what will actually be searched, next to the query so an unnoticed
                 scope filter is never mistaken for "genuinely no matches". -->
            <TextBlock Grid.Column="1" Classes="HeaderLabel" HorizontalAlignment="Right"
                       Text="{Binding ScopeSummary, StringFormat='Scope: {0}'}" />
        </Grid>

        <ItemsControl Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding RecentSearches}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:SearchHistoryEntry">
                    <Button Classes="FilterPill"
                            Content="{Binding QueryText}"
                            ToolTip.Tip="{Binding ScopeDescription}"
                            Command="{Binding #Root.((vm:SearchViewModel)DataContext).RerunSearchCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3" Classes="HeaderLabel" Margin="0,8,0,0" Text="{Binding QueryIpa, StringFormat='IPA: {0}'}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Classes="FieldLabel" Text="{Binding StatusMessage}" VerticalAlignment="Center" />

            <!-- Addendum §25: search the selected sources first; only offer the full corpus once
                 that comes back empty, rather than widening by default. -->
            <Button Content="Search full corpus instead"
                    Command="{Binding SearchFullCorpusCommand}"
                    IsVisible="{Binding CanWidenToFullCorpus}" />
        </StackPanel>

        <!-- #25 exit criterion 2: coverage as a first-class sort/filter axis alongside score - a
             normalized score alone conflates "matched a little, well" with "matched a lot,
             roughly". Single-source only for now; composite results have no per-component
             coverage strip yet. -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12" Margin="0,6,0,0"
                    IsVisible="{Binding !IsCompositeMode}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="FieldLabel" Text="Sort:" VerticalAlignment="Center" />
                <ComboBox SelectedItem="{Binding SortMode}" ItemsSource="{Binding SortModeOptions}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="FieldLabel" Text="Min. coverage:" VerticalAlignment="Center" />
                <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding MinimumCoverage}" VerticalAlignment="Center" />
                <TextBlock Classes="FieldLabel" Text="{Binding MinimumCoverage, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- #25 exit criterion 4: "many hits are the same word from different timestamps -
                 grouping by covered span is more useful than a flat ranked list." Opt-in, alongside
                 the flat list rather than replacing it. -->
            <CheckBox Content="Group by covered span" IsChecked="{Binding GroupByCoverage}" VerticalAlignment="Center" />

            <!-- #25 exit criterion 3: a manual driver for the composite assembly the app can
                 already do mechanically - one candidate per covered span, chosen by hand rather
                 than by the matcher. Needs grouping on first, since a slot's candidate list is
                 exactly a covered-span group. -->
            <Button Content="Start assembly..." Command="{Binding StartAssemblyCommand}"
                    IsVisible="{Binding GroupByCoverage}" />
        </StackPanel>

        <ListBox Grid.Row="6" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                 ItemTemplate="{StaticResource ResultRowTemplate}"
                 IsVisible="{Binding ShowFlatResults}" />

        <ScrollViewer Grid.Row="6" IsVisible="{Binding ShowAssemblyDraft}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Classes="HeaderLabel" Text="ASSEMBLY DRAFT" />
                    <TextBlock Classes="FieldLabel" Text="{Binding AssemblyDraft.CoverageSummary}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding AssemblyDraft.Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssemblySlotViewModel">
                            <Border Padding="8" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderMid}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                                                  Width="360" PlaceholderText="Skipped - not included in the assembly">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SearchResultRowViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SourceText}" />
                                                        <TextBlock Classes="FieldLabel" Text="{Binding ScoreDisplay}" />
                                                        <TextBlock Classes="FieldLabel" Text="{Binding TimeRangeDisplay}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Skip this span" Command="{Binding SkipCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button Content="▶ Audition" Command="{Binding AssemblyDraft.AuditionCommand}" />
                    <Button Content="Export assembled clip..." Command="{Binding AssemblyDraft.ExportCommand}" />
                    <Button Content="Close draft" Command="{Binding CloseAssemblyCommand}" />
                </StackPanel>
                <TextBlock Classes="FieldLabel" Text="{Binding AssemblyDraft.Status}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="6" IsVisible="{Binding ShowGroupedResults}">
            <ItemsControl ItemsSource="{Binding ResultGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultGroupViewModel">
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                <TextBlock Classes="HeaderLabel" Text="{Binding Label}" FontWeight="Bold" />
                                <TextBlock Classes="FieldLabel" Text="{Binding Count, StringFormat='({0} result(s))'}" />
                            </StackPanel>
                            <!-- A ListBox, not a plain ItemsControl, so a row clicked inside a
                                 group can still drive the shared Inspector panel (#25/#15) - bound
                                 to the same SelectedResult the flat list uses, via #Root since this
                                 template's own DataContext is the group, not the SearchViewModel. -->
                            <ListBox ItemsSource="{Binding Members}" ItemTemplate="{StaticResource ResultRowTemplate}"
                                     SelectedItem="{Binding #Root.((vm:SearchViewModel)DataContext).SelectedResult}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ListBox Grid.Row="6" ItemsSource="{Binding CompositeResults}" IsVisible="{Binding IsCompositeMode}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CompositeSearchResultRowViewModel">
                    <Border Padding="8" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderMid}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding ScoreDisplay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Classes="HeaderLabel" Text="{Binding SourceCountDisplay}" />
                                <Button Content="Export assembled clip..." Command="{Binding ExportClipCommand}" />
                            </StackPanel>
                            <TextBlock Classes="FieldLabel" Text="{Binding ExportStatus}" />

                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompositeComponentRowViewModel">
                                        <Border Padding="6" Margin="12,2,0,2" BorderThickness="1" BorderBrush="{StaticResource BorderSubtle}" CornerRadius="3">
                                            <StackPanel Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding MediaTitle}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Classes="HeaderLabel" Text="{Binding TimeRangeDisplay}" />
                                                    <TextBlock Classes="HeaderLabel" Text="{Binding ScoreDisplay}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SourceText}" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Classes="FieldLabel" Text="{Binding Ipa}" FontFamily="monospace" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
