<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MemeSearcher.ViewModels"
             xmlns:settings="using:MemeSearcher.Core.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="MemeSearcher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="10"
                CornerRadius="4"
                Background="{StaticResource StatusErrorMuted}"
                IsVisible="{Binding HasValidationMessage}">
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="External tool status" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <Button Content="Refresh"
                        Command="{Binding RefreshToolStatusesCommand}"
                        IsEnabled="{Binding !IsRefreshingToolStatuses}" />
            </StackPanel>

            <TextBlock Text="{Binding ToolStatusError}"
                       IsVisible="{Binding HasToolStatusError}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimary}" />

            <ItemsControl ItemsSource="{Binding ToolStatuses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExternalToolStatusViewModel">
                        <Grid ColumnDefinitions="130,220,*" Margin="0,2,0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="{Binding Summary}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding Details}" Classes="FieldLabel" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                        <StackPanel Margin="0,0,0,20" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Classes="HeaderLabel" Text="{Binding Description}" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Settings}" Margin="0,8,0,0">
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:ChoiceSettingViewModel">
                                        <StackPanel Margin="0,0,0,12" Spacing="3">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <ComboBox ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding SelectedChoice}"
                                                      MinWidth="260">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="settings:SettingChoice">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Classes="FieldLabel" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </DataTemplate>

                                    <DataTemplate DataType="vm:InfoSettingViewModel">
                                        <Border Margin="0,0,0,12"
                                                Padding="10"
                                                CornerRadius="4"
                                                Background="{StaticResource BgSurface}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Classes="FieldLabel"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           FontFamily="monospace" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>

                                    <DataTemplate DataType="vm:ToggleSettingViewModel">
                                        <StackPanel Margin="0,0,0,12" Spacing="3">
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" />
                                            <TextBlock Classes="FieldLabel" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </DataTemplate>

                                    <DataTemplate DataType="vm:TextSettingViewModel">
                                        <StackPanel Margin="0,0,0,12" Spacing="3">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBox Text="{Binding Value}" MinWidth="260" HorizontalAlignment="Left" />
                                            <TextBlock Classes="FieldLabel" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
