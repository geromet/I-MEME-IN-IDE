<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MemeSearcher.ViewModels"
        xmlns:views="using:MemeSearcher.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MemeSearcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Title="Phonetic Search"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">

    <!-- #19: every panel a zone hosts is resolved by App.axaml's global ViewLocator (by naming
         convention) - adding a new panel is a DI registration (App.axaml.cs), never an edit here. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ══ MENU (#19: View toggles registered panels, Tools runs library-wide actions) ══ -->
        <Menu Grid.Row="0" Classes="Toolbar">
            <MenuItem Header="_View" ItemsSource="{Binding Panels}">
                <MenuItem.ItemTemplate>
                    <DataTemplate x:DataType="vm:PanelSlotViewModel">
                        <MenuItem Header="{Binding DisplayName}" ToggleType="CheckBox" IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Add Media..." Command="{Binding Library.ImportCommand}" />
                <MenuItem Header="Reindex" Command="{Binding Library.ReindexCommand}" />
            </MenuItem>
        </Menu>

        <!-- ══ TOOLBAR ══ -->
        <DockPanel Grid.Row="1" Classes="Toolbar" LastChildFill="False">
            <Button DockPanel.Dock="Left" Classes="Toolbar" Content="Add Media..." Command="{Binding Library.ImportCommand}" />
            <Button DockPanel.Dock="Left" Classes="Toolbar" Content="Reindex" Command="{Binding Library.ReindexCommand}" />
            <Button DockPanel.Dock="Left" Classes="Toolbar" Content="+ New Search" Command="{Binding NewSearchTabCommand}" />
            <Button DockPanel.Dock="Left" Classes="Toolbar" Content="Jobs / Errors" Command="{Binding ToggleJobsPanelCommand}" />
        </DockPanel>

        <!-- ══ BODY: left zone | documents (+ collapsible bottom zone) | right zone ══ -->
        <Grid Grid.Row="2" ColumnDefinitions="240,4,*,4,260">

            <!-- LEFT ZONE (Library by default). -->
            <Border Grid.Column="0" Classes="Panel" BorderThickness="0,0,1,0" IsVisible="{Binding HasLeftPanels}">
                <TabControl ItemsSource="{Binding LeftPanels}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PanelSlotViewModel">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:PanelSlotViewModel">
                            <ContentControl Content="{Binding Content}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" IsVisible="{Binding HasLeftPanels}" />

            <!-- DOCUMENT AREA: one tab per executed search, plus a collapsible bottom zone. -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto">
                <TabControl Grid.Row="0"
                            ItemsSource="{Binding SearchTabs}"
                            SelectedItem="{Binding ActiveSearchTab}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchViewModel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding QueryText, TargetNullValue='New Search', FallbackValue='New Search'}" VerticalAlignment="Center" />
                                <Button Classes="TabClose"
                                        Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CloseSearchTabCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:SearchViewModel">
                            <views:SearchView DataContext="{Binding}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" IsVisible="{Binding HasBottomPanels}" />

                <!-- BOTTOM ZONE (Jobs/Errors by default, hidden until toggled - #14). -->
                <Border Grid.Row="2" Classes="Panel" BorderThickness="0,1,0,0" Height="180"
                        IsVisible="{Binding HasBottomPanels}">
                    <TabControl ItemsSource="{Binding BottomPanels}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PanelSlotViewModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:PanelSlotViewModel">
                                <ContentControl Content="{Binding Content}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns" IsVisible="{Binding HasRightPanels}" />

            <!-- RIGHT ZONE (Inspector by default; Settings shares this zone as a second tab - #19). -->
            <Border Grid.Column="4" Classes="Panel" BorderThickness="1,0,0,0" IsVisible="{Binding HasRightPanels}">
                <TabControl ItemsSource="{Binding RightPanels}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PanelSlotViewModel">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:PanelSlotViewModel">
                            <ContentControl Content="{Binding Content}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>
        </Grid>

        <!-- ══ STATUS BAR ══ -->
        <DockPanel Grid.Row="3" Classes="StatusBar">
            <TextBlock Classes="FieldLabel" Margin="10,0" VerticalAlignment="Center"
                       Text="{Binding Library.Items.Count, StringFormat='{}{0} media in library'}" />
            <TextBlock Classes="FieldLabel" Margin="0,0,10,0" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Text="Index: use Reindex on the toolbar to rebuild" />
        </DockPanel>
    </Grid>
</Window>
