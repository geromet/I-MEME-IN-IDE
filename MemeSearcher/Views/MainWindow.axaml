<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MemeSearcher.ViewModels"
        xmlns:views="using:MemeSearcher.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="MemeSearcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Phonetic Search"
        Width="800" Height="600">
    <TabControl>
        <TabItem Header="Search">
            <views:SearchView DataContext="{Binding Search}" />
        </TabItem>
        <TabItem Header="Library">
            <views:LibraryView DataContext="{Binding Library}" />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
